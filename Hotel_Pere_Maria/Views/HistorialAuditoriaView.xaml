<Window x:Class="Hotel_Pere_Maria.Views.HistorialAuditoriaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="Historial de Modificaciones" Height="600" Width="550"
        WindowStartupLocation="CenterOwner" Background="#F5F6F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="HISTORIAL DE AUDITORÍA" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" FontFamily="Segoe UI Black" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock Text="Reserva: " FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ReservationId}" FontSize="13" Foreground="#2C3E50" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <Separator Grid.Row="1" Background="#BDC3C7" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding LogEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="10" Margin="5,0,5,15" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="Black"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <Border CornerRadius="4" Padding="8,4" VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding action}" Value="CREATE">
                                                        <Setter Property="Background" Value="#2ECC71"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding action}" Value="UPDATE">
                                                        <Setter Property="Background" Value="#3498DB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding action}" Value="CANCEL">
                                                        <Setter Property="Background" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding action}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>

                                    <TextBlock Text="{Binding timestamp, StringFormat='dd/MM/yyyy HH:mm:ss'}" 
                                               DockPanel.Dock="Right" VerticalAlignment="Center" 
                                               Foreground="#95A5A6" FontSize="11" FontWeight="SemiBold"/>

                                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Por: " Foreground="#7F8C8D" FontSize="12"/>
                                        <TextBlock Text="{Binding user_id}" Foreground="#2C3E50" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding role, StringFormat=' ({0})'}" Foreground="#95A5A6" FontSize="11" FontStyle="Italic"/>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <Separator Background="#F0F0F0" Margin="0,0,0,10"/>

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Habitación: " Foreground="#7F8C8D" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding new_state.room_id}" Foreground="#2C3E50" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Cliente (ID): " Foreground="#7F8C8D" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding new_state.user_id}" Foreground="#2C3E50" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Precio total: " Foreground="#7F8C8D" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding new_state.price, StringFormat={}{0:N2}€}" Foreground="#2C3E50" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Entrada: " Foreground="#7F8C8D" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding new_state.check_in, StringFormat='dd/MM/yyyy'}" Foreground="#2C3E50" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Salida: " Foreground="#7F8C8D" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding new_state.check_out, StringFormat='dd/MM/yyyy'}" Foreground="#2C3E50" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding action}" Value="CANCEL">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="Cancelada el: " Foreground="#E74C3C" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding new_state.cancelation_date, StringFormat='dd/MM/yyyy'}" Foreground="#E74C3C" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Cerrar Ventana" 
                Background="#95A5A6" Foreground="White" FontWeight="Bold" Width="130" Height="35"
                HorizontalAlignment="Right" Margin="0,10,5,0" Click="Cerrar_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
