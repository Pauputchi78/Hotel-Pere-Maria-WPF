<Window x:Class="Hotel_Pere_Maria.Views.AjustesCancelacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="AjustesCancelacion" Height="250" Width="400">
    
    <Border Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="10"
        BorderBrush="#BDC3C7" BorderThickness="1" Width="380">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Porcentajes de Devolución" 
                   FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Si faltan más de 7 días devolver el:" Width="200" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Width="60" Height="26" InputScope="Number" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         Text="{Binding PorcentajeMas7Dias, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Si faltan más de 3 días devolver el:" Width="200" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Width="60" Height="26" InputScope="Number" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         Text="{Binding PorcentajeMas3Dias, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Bold" Foreground="#E67E22"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="80" Height="28" Background="#95A5A6" Foreground="White" Margin="0,0,8,0"
                    Command="{Binding CancelarAjustesCommand}"/>
                <Button Content="Guardar" Width="80" Height="28" Background="#2980B9" Foreground="White"
                    Command="{Binding GuardarAjustesCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
